
#include <stdio.h>
#include <string.h>

int main()
{
    char exp[100], left[20], right[20], op;
    char temp[20];
    int i, t = 1;

    printf("Enter expression (e.g., a+b*c): ");
    scanf("%s", exp);

    while (1)
    {
        int found = 0;

        // Check multiplication and division first
        for (i = 0; exp[i] != '\0'; i++)
        {
            if (exp[i] == '*' || exp[i] == '/')
            {
                found = 1;
                break;
            }
        }

        // Check addition and subtraction
        if (!found)
        {
            for (i = 0; exp[i] != '\0'; i++)
            {
                if (exp[i] == '+' || exp[i] == '-')
                {
                    found = 1;
                    break;
                }
            }
        }

        if (!found)
            break;

        op = exp[i];

        // Find left operand
        int l = i - 1;
        while (l >= 0 && exp[l] != '+' && exp[l] != '-' &&
               exp[l] != '*' && exp[l] != '/')
            l--;

        strncpy(left, exp + l + 1, i - l - 1);
        left[i - l - 1] = '\0';

        // Find right operand
        int r = i + 1;
        while (exp[r] != '\0' && exp[r] != '+' &&
               exp[r] != '-' && exp[r] != '*' && exp[r] != '/')
            r++;

        strncpy(right, exp + i + 1, r - i - 1);
        right[r - i - 1] = '\0';

        printf("t%d = %s %c %s\n", t, left, op, right);

        // Create temporary variable
        sprintf(temp, "t%d", t);

        // Replace expression with temporary variable
        char newexp[100];

        strncpy(newexp, exp, l + 1);
        newexp[l + 1] = '\0';

        strcat(newexp, temp);
        strcat(newexp, exp + r);

        strcpy(exp, newexp);

        t++;
    }

    printf("Result = %s\n", exp);

    return 0;
}
